  { title: 'Explicando o Amor para Idiotas', cover: '/capas/explicando-amor.jpg', slug: 'explicando-o-amor', genre: 'nonfiction', authors: ['Kcinom Nilpoj'] },
  { title: 'Eu não gosto dessa personagem!', subtitle: 'Minhas experiências na escrita de fantasia', cover: '/capas/personagem.jpg', slug: 'eu-nao-gosto-dessa-personagem', genre: 'nonfiction', authors: ['Kcinom Nilpoj'] },
];

const filtros = [
  { id: 'all', label: 'Todos' },
  { id: 'romantasy', label: 'Dark Romantasy' },
  { id: 'fantasy-eastern', label: 'Fantasia Oriental' },
  { id: 'fantasy-lit', label: 'Fantasia Literária' },
  { id: 'scifi', label: 'Ficção Científica' },
  { id: 'steampunk', label: 'Steampunk' },
  { id: 'romance', label: 'Romance' },
  { id: 'nonfiction', label: 'Não-ficção' }
];
---

<BaseLayout 
  title="Acervo" 
  description="Acervo completo KCIN Editoria — fantasia, romance, ficção científica, não-ficção."
>
  <section class="acervo-hero">
    <div class="container">
      <p class="section-eyebrow fade-in">Biblioteca · Portfólio</p>
      <h1 class="acervo-title fade-in">Acervo KCIN</h1>
      <p class="acervo-desc container-narrow fade-in">
        Toda a produção autoral do selo. Cada capa é livro publicado e também 
        peça de portfólio de design. Clique pra ler ou conferir.
      </p>
    </div>
  </section>
  
  <section class="acervo-filters">
    <div class="container">
      <div class="filters-list">
        {filtros.map(f => (
          <button class="filter-btn" data-filter={f.id} data-active={f.id === 'all'}>
            {f.label}
          </button>
        ))}
      </div>
    </div>
  </section>
  
  <section class="acervo-grid-section">
    <div class="container">
      <div class="acervo-grid">
        {livros.map(livro => (
          <div class="acervo-item" data-genre={livro.genre}>
            <BookCard {...livro} />
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <script>
    const filterButtons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.acervo-item');
    
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        filterButtons.forEach(b => b.setAttribute('data-active', 'false'));
        btn.setAttribute('data-active', 'true');
        
        items.forEach(item => {
          const genre = item.getAttribute('data-genre');
          const shouldShow = filter === 'all' || genre === filter;
          const el = item as HTMLElement;
          
          if (shouldShow) {
            el.style.display = '';
            setTimeout(() => item.classList.add('visible'), 50);
          } else {
            item.classList.remove('visible');
            setTimeout(() => el.style.display = 'none', 300);
          }
        });
      });
    });
    
    // Aplica filtro inicial da URL (?g=romantasy)
    const urlParams = new URLSearchParams(window.location.search);
    const initialFilter = urlParams.get('g');
    if (initialFilter) {
      const btn = document.querySelector(`[data-filter="${initialFilter}"]`);
      if (btn) (btn as HTMLElement).click();
    }
  </script>
</BaseLayout>

<style>
  .acervo-hero {
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
  }
  
  .acervo-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--kcin-gold-light);
    margin: var(--space-3) 0 var(--space-4);
    letter-spacing: 0.05em;
  }
  
  .acervo-desc {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--kcin-parchment);
    line-height: 1.7;
  }
  
  .acervo-filters {
    padding: var(--space-6) 0 var(--space-12);
    position: sticky;
    top: 80px;
    z-index: 50;
    background: rgba(10, 6, 18, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(212, 165, 116, 0.1);
  }
  
  .filters-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }
  
  .filter-btn {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: var(--space-2) var(--space-4);
    background: transparent;
    color: var(--kcin-ash);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease);
    border-radius: var(--radius-sm);
  }
  
  .filter-btn:hover {
    color: var(--kcin-gold-light);
    border-color: var(--kcin-gold-dim);
  }
  
  .filter-btn[data-active="true"] {
    color: var(--kcin-black);
    background: var(--kcin-gold);
    border-color: var(--kcin-gold);
  }
  
  .acervo-grid-section {
    padding: var(--space-8) 0 var(--space-16);
  }
  
  .acervo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-8) var(--space-6);
  }
  
  .acervo-item {
    transition: opacity var(--duration-base) var(--ease);
  }
</style>
