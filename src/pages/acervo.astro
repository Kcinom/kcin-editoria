---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookRow from '../components/BookRow.astro';
import PosterCard from '../components/PosterCard.astro';
import BookSheet from '../components/BookSheet.astro';
import Icon from '../components/Icon.astro';
import { livros, generos, fileiras, lancamentos, maisLidos, emRevisao } from '../data/livros';
const rows = fileiras();
---

<BaseLayout
  title="Acervo"
  description="Acervo completo KCIN Editoria — fantasia, romance, ficção científica, não-ficção e fanfics."
>
  <div class="app-page">
    <div class="container app-toolbar">
      <h1 class="sr-only">Acervo KCIN</h1>
      <label class="search">
        <Icon name="search" size={18} />
        <input type="search" id="busca" placeholder="Buscar" aria-label="Buscar livro" autocomplete="off" />
      </label>
      <div class="chips" aria-label="Gêneros">
        <button type="button" class="chip-btn" data-filter="all" aria-pressed="true">Todos</button>
        {Object.entries(generos).map(([id, label]) => (
          <button type="button" class="chip-btn" data-filter={id} aria-pressed="false">{label}</button>
        ))}
      </div>
    </div>

    <div id="rows" class="container rows">
      <BookRow title="Novos para ler" books={lancamentos()} big />
      <BookRow title="Mais lidos" books={maisLidos()} big />
      <BookRow title="Em breve · em revisão" books={emRevisao()} />
      {rows.map(r => <BookRow title={r.title} books={r.books} />)}
    </div>

    <div id="results" class="container results" hidden>
      <div class="results-grid">
        {livros.map(l => <PosterCard livro={l} />)}
      </div>
      <p id="vazio" class="empty" hidden>Nenhum livro encontrado.</p>
    </div>
  </div>

  <BookSheet />
</BaseLayout>

<script>
  const busca = document.getElementById('busca') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip-btn')];
  const rows = document.getElementById('rows')!;
  const results = document.getElementById('results')!;
  const vazio = document.getElementById('vazio')!;
  const posters = [...results.querySelectorAll<HTMLElement>('.poster')];
  let genero = 'all';

  function aplicar() {
    const q = busca.value.trim().toLowerCase();
    const filtrando = q !== '' || genero !== 'all';
    rows.hidden = filtrando;
    results.hidden = !filtrando;
    let n = 0;
    posters.forEach(p => {
      const ok = (genero === 'all' || p.dataset.genre === genero) && (!q || (p.dataset.title || '').includes(q));
      p.hidden = !ok; if (ok) n++;
    });
    vazio.hidden = n > 0;
  }
  chips.forEach(c => c.addEventListener('click', () => {
    genero = c.dataset.filter!;
    chips.forEach(x => x.setAttribute('aria-pressed', String(x === c)));
    c.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
    aplicar();
  }));
  busca.addEventListener('input', aplicar);

  const g = new URLSearchParams(location.search).get('g');
  if (g) chips.find(c => c.dataset.filter === g)?.click();
</script>
