---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPABASE_URL, SUPABASE_KEY, FORMSPREE_URL } from '../lib/atelier-config.js';

/*
  TABELA DE PREÇO — usada pelo orçamento automático.
  Para mudar valores, edite só aqui. [mínimo, máximo] em reais.
*/
const PRECOS = {
  capaEbook: [700, 900],
  capaWrap: [1100, 1400],
  diag200: [800, 1000],     // até 200 páginas
  diag400: [1000, 1400],    // 201 a 400 páginas
  diag400mais: [1400, 1800],// mais de 400 páginas
  descontoCompleto: 0.15,   // capa + miolo juntos
  descontoSeriePorVolume: 0.05, // cada volume extra ganha +5% de desconto...
  descontoSerieMax: 0.25,       // ...até no máximo 25%
  urgencia: 0.25            // prazo curto
};

const servicos = [
  {
    name: 'Capa',
    tagline: 'A primeira página do livro',
    desc: 'Front-cover (ebook) ou wrap completo (impressão). Direção visual autoral por gênero.',
    features: [
      'Capa em alta resolução (300 DPI)',
      'Formato otimizado pra Amazon KDP',
      'Lombada calculada (no wrap)',
      'Mock-up 3D pra divulgação',
      'Até 2 rodadas de revisão'
    ],
    from: PRECOS.capaEbook[0]
  },
  {
    name: 'Diagramação de miolo',
    tagline: 'O livro por dentro',
    desc: 'Layout interno completo — do sumário à última página. Pode ser contratada sozinha, mesmo com capa de outro profissional.',
    features: [
      'Projeto gráfico do miolo',
      'Tipografia de corpo e títulos',
      'Letras capitulares e aberturas de capítulo',
      'Sumário, fólios e cabeçalhos',
      'Arquivos finais: PDF impressão + EPUB'
    ],
    from: PRECOS.diag200[0]
  },
  {
    name: 'Livro completo',
    tagline: 'Da capa à última página',
    desc: 'Capa e diagramação na mesma direção autoral, com desconto por contratar os dois juntos.',
    features: [
      'Tudo de Capa + Diagramação',
      'Identidade visual coerente capa↔miolo',
      'Arquivos prontos pra KDP (ebook e impressão)',
      `${PRECOS.descontoCompleto * 100}% de desconto no pacote`
    ],
    featured: true,
    from: Math.round((PRECOS.capaEbook[0] + PRECOS.diag200[0]) * (1 - PRECOS.descontoCompleto) / 10) * 10
  },
  {
    name: 'Série editorial',
    tagline: 'Identidade pra uma saga',
    desc: 'Sistema visual unificado para série de 2 a 6 livros — capas e miolos consistentes.',
    features: [
      'Sistema visual de série',
      'Paleta canônica por volume',
      'Diagramação consistente entre livros',
      `Desconto progressivo por volume (até ${PRECOS.descontoSerieMax * 100}%)`
    ],
    from: null
  }
];

const generosAtendidos = [
  'Dark Romantasy',
  'Fantasia Literária',
  'Fantasia Oriental',
  'Ficção Científica',
  'Romance Contemporâneo',
  'Romance Fairy Tale',
  'Steampunk',
  'Não-ficção'
];

const brl = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
---

<BaseLayout
  title="Atelier"
  description="Atelier KCIN — capa e diagramação para autores indie. Orçamento na hora, trabalho autoral, sem pressa."
>

  <section class="atelier-hero">
    <div class="container">
      <p class="section-eyebrow fade-in">Atelier</p>
      <h1 class="atelier-title fade-in">Da capa à última página</h1>
      <p class="atelier-tagline container-narrow fade-in">
        Capa e diagramação pra autores indie que entendem que um livro
        se constrói por inteiro — não só por fora.
      </p>
    </div>
  </section>

  <div class="divider-ornament"><span>❦</span></div>

  <section class="atelier-note-section">
    <div class="container container-narrow">
      <div class="atelier-note fade-in">
        <p class="atelier-note-text">
          O atelier KCIN trabalha com <em>poucos projetos por vez</em>.
          Tudo acontece por aqui e por e-mail: você calcula o orçamento,
          envia a ficha do projeto e recebe a resposta conforme a agenda abre.
        </p>
      </div>
    </div>
  </section>

  <section class="atelier-philosophy">
    <div class="container container-narrow">
      <div class="fade-in">
        <p class="section-eyebrow">Filosofia</p>
        <h2 class="section-title">Direção autoral, do início ao fim</h2>
        <p class="philosophy-text">
          Um livro não termina na capa. A tipografia do miolo, a letra capitular
          que abre o capítulo, o respiro das margens, o sumário — tudo isso é
          experiência de leitura.
        </p>
        <p class="philosophy-text">
          No Atelier KCIN, capa e diagramação saem da mesma direção visual.
          Mas cada serviço pode ser contratado <em>sozinho</em>: se você já tem
          capa e precisa só do miolo, ou só da capa, sem problema.
        </p>
      </div>
    </div>
  </section>

  <section class="genres-section">
    <div class="container">
      <div class="section-header fade-in">
        <p class="section-eyebrow">Especialidades</p>
        <h2 class="section-title">Gêneros atendidos</h2>
      </div>
      <div class="genres-grid">
        {generosAtendidos.map(g => <div class="genre-pill fade-in">{g}</div>)}
      </div>
    </div>
  </section>

  <section class="services">
    <div class="container">
      <div class="section-header fade-in">
        <p class="section-eyebrow">O que o atelier oferece</p>
        <h2 class="section-title">Serviços</h2>
        <p class="section-desc container-narrow">
          Cada serviço pode ser contratado de forma independente.
          Calcule o valor do seu projeto no orçamento abaixo.
        </p>
      </div>
      <div class="services-grid">
        {servicos.map(s => (
          <div class={`service-card fade-in ${s.featured ? 'featured' : ''}`}>
            {s.featured && <span class="service-badge">Pacote completo</span>}
            <h3 class="service-name">{s.name}</h3>
            <p class="service-card-tagline">{s.tagline}</p>
            <p class="service-desc">{s.desc}</p>
            <ul class="service-features">
              {s.features.map(f => <li>{f}</li>)}
            </ul>
            <p class="service-price">
              {s.from ? `A partir de ${brl(s.from)}` : 'Desconto por volume'}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container">
      <div class="section-header fade-in">
        <p class="section-eyebrow">Como funciona</p>
        <h2 class="section-title">Processo</h2>
      </div>
      <div class="process-grid">
        <div class="process-step fade-in">
          <span class="process-number">01</span>
          <h3>Orçamento e ficha</h3>
          <p>Você calcula o valor aqui no site e envia a ficha com todos os detalhes do projeto.</p>
        </div>
        <div class="process-step fade-in">
          <span class="process-number">02</span>
          <h3>Análise</h3>
          <p>Avalio a ficha e respondo por e-mail se o projeto foi aceito, com o valor final confirmado.</p>
        </div>
        <div class="process-step fade-in">
          <span class="process-number">03</span>
          <h3>Sinal de 50%</h3>
          <p>Aceito o projeto, você recebe um link de pagamento do sinal. O trabalho começa após a confirmação.</p>
        </div>
        <div class="process-step fade-in">
          <span class="process-number">04</span>
          <h3>Execução</h3>
          <p>Prévias enviadas por e-mail, com até 2 rodadas de revisão inclusas.</p>
        </div>
        <div class="process-step fade-in">
          <span class="process-number">05</span>
          <h3>Entrega</h3>
          <p>Pago o restante (50%) pelo segundo link, você recebe os arquivos finais prontos pra KDP.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-cta" id="orcamento">
    <div class="container container-narrow">
      <div class="quote-card fade-in">
        <h2 class="section-title">Orçamento e ficha do projeto</h2>
        <p class="quote-desc">
          Preencha as informações: o valor estimado aparece na hora.
          Ao enviar, sua ficha entra na fila de análise.
        </p>

        <form
          action={FORMSPREE_URL}
          method="POST"
          class="quote-form"
          id="atelier-form"
        >
          <fieldset class="form-group">
            <legend class="form-legend">1 · O que você precisa</legend>

            <label class="form-field">
              <span class="form-label">Serviço</span>
              <select name="servico" id="f-servico" required class="form-input">
                <option value="capa">Capa</option>
                <option value="diagramacao">Diagramação de miolo</option>
                <option value="completo" selected>Livro completo (capa + miolo)</option>
              </select>
            </label>

            <label class="form-field" data-show="capa">
              <span class="form-label">Tipo de capa</span>
              <select name="tipo_capa" id="f-capa" class="form-input">
                <option value="ebook">Só frente (ebook)</option>
                <option value="wrap" selected>Wrap completo (impressão: frente, lombada e verso)</option>
              </select>
            </label>

            <label class="form-field" data-show="diag">
              <span class="form-label">Número aproximado de páginas</span>
              <input type="number" name="paginas" id="f-paginas" min="1" max="2000" value="250" class="form-input" />
              <span class="form-hint">Se não souber: 1 página de livro ≈ 250 palavras.</span>
            </label>

            <div class="form-row">
              <label class="form-field">
                <span class="form-label">Volumes</span>
                <select name="volumes" id="f-volumes" class="form-input">
                  <option value="1" selected>1 livro</option>
                  <option value="2">2 (série)</option>
                  <option value="3">3 (série)</option>
                  <option value="4">4 (série)</option>
                  <option value="5">5 (série)</option>
                  <option value="6">6 (série)</option>
                </select>
              </label>

              <label class="form-field">
                <span class="form-label">Prazo</span>
                <select name="prazo" id="f-prazo" class="form-input">
                  <option value="normal" selected>Normal (fila da agenda)</option>
                  <option value="urgente">Urgente (+{PRECOS.urgencia * 100}%)</option>
                </select>
              </label>
            </div>
          </fieldset>

          <div class="estimate" aria-live="polite">
            <p class="estimate-label">Valor estimado</p>
            <p class="estimate-value" id="estimate-value">—</p>
            <p class="estimate-detail" id="estimate-detail"></p>
            <p class="estimate-pay" id="estimate-pay"></p>
            <p class="estimate-note">
              Estimativa pela tabela do atelier. O valor final é confirmado por e-mail
              na análise da ficha, dentro desta faixa.
            </p>
          </div>

          <input type="hidden" name="estimativa" id="f-estimativa" />

          <fieldset class="form-group">
            <legend class="form-legend">2 · Sobre você</legend>
            <div class="form-row">
              <label class="form-field">
                <span class="form-label">Nome ou pseudônimo</span>
                <input type="text" name="nome" required class="form-input" />
              </label>
              <label class="form-field">
                <span class="form-label">E-mail</span>
                <input type="email" name="email" required class="form-input" />
              </label>
            </div>
          </fieldset>

          <fieldset class="form-group">
            <legend class="form-legend">3 · Sobre a obra</legend>
            <label class="form-field">
              <span class="form-label">Título da obra (ou da série)</span>
              <input type="text" name="titulo" required class="form-input" />
            </label>
            <label class="form-field" data-show="capa">
              <span class="form-label">Nome que vai na capa</span>
              <input type="text" name="nome_capa" class="form-input" />
            </label>
            <label class="form-field">
              <span class="form-label">Gênero</span>
              <select name="genero" required class="form-input">
                <option value="">Selecione...</option>
                {generosAtendidos.map(g => <option value={g}>{g}</option>)}
                <option value="Outro">Outro</option>
              </select>
            </label>
            <label class="form-field">
              <span class="form-label">Sinopse curta</span>
              <textarea name="sinopse" rows="4" required class="form-input form-textarea"></textarea>
            </label>
            <label class="form-field" data-show="capa">
              <span class="form-label">Direção visual da capa</span>
              <textarea name="direcao_visual" rows="4" class="form-input form-textarea"
                placeholder="Clima, cores, elementos, personagens, o que NÃO quer..."></textarea>
            </label>
            <label class="form-field">
              <span class="form-label">Referências (links)</span>
              <textarea name="referencias" rows="3" class="form-input form-textarea"
                placeholder="Pinterest, capas que você gosta, livros parecidos..."></textarea>
            </label>
            <label class="form-field" data-show="diag">
              <span class="form-label">Link do manuscrito (opcional agora)</span>
              <input type="url" name="manuscrito" class="form-input" placeholder="Google Drive, Dropbox..." />
              <span class="form-hint">Para diagramação, o texto precisa estar final e revisado.</span>
            </label>
            <label class="form-field">
              <span class="form-label">Prazo desejado / data de lançamento</span>
              <input type="text" name="data_desejada" class="form-input" placeholder="Ex.: março de 2027" />
            </label>
          </fieldset>

          <fieldset class="form-group">
            <legend class="form-legend">4 · Termos</legend>
            <ul class="terms-list">
              <li>O envio da ficha não garante a aceitação do projeto.</li>
              <li>Aceito o projeto, o trabalho começa após o pagamento do sinal de 50%, por link.</li>
              <li>Os 50% restantes são pagos antes da entrega dos arquivos finais.</li>
              <li>Até 2 rodadas de revisão inclusas; revisões extras são orçadas à parte.</li>
              <li>Toda a comunicação acontece por e-mail.</li>
            </ul>
            <label class="form-check">
              <input type="checkbox" name="aceite_termos" value="sim" required />
              <span>Li e concordo com os termos acima.</span>
            </label>
          </fieldset>

          <button type="submit" class="btn" id="f-enviar">Enviar ficha</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>

        <div class="form-success" id="form-success" hidden>
          <p class="section-eyebrow">Ficha recebida</p>
          <h3 class="success-title">Obrigada!</h3>
          <p class="quote-desc">
            Sua ficha entrou na fila de análise. Você recebe a resposta por e-mail
            assim que a agenda abrir — se o projeto for aceito, junto vem o valor
            final e o link do sinal.
          </p>
        </div>

        <p class="quote-note">
          Dúvidas: <a href="mailto:contato@kcineditoria.com.br" class="link-elegant">contato@kcineditoria.com.br</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<script define:vars={{ PRECOS, SUPABASE_URL, SUPABASE_KEY, FORMSPREE_URL }}>
  const $ = (id) => document.getElementById(id);
  const form = $('atelier-form');
  const brl = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
  const r10 = (v) => Math.round(v / 10) * 10;

  function precoDiag(p) {
    if (p <= 200) return PRECOS.diag200;
    if (p <= 400) return PRECOS.diag400;
    return PRECOS.diag400mais;
  }

  function calcular() {
    const servico = $('f-servico').value;
    const temCapa = servico === 'capa' || servico === 'completo';
    const temDiag = servico === 'diagramacao' || servico === 'completo';

    // mostra/esconde campos conforme o serviço
    form.querySelectorAll('[data-show="capa"]').forEach(el => el.hidden = !temCapa);
    form.querySelectorAll('[data-show="diag"]').forEach(el => el.hidden = !temDiag);

    let min = 0, max = 0;
    if (temCapa) {
      const c = $('f-capa').value === 'wrap' ? PRECOS.capaWrap : PRECOS.capaEbook;
      min += c[0]; max += c[1];
    }
    if (temDiag) {
      const paginas = parseInt($('f-paginas').value, 10) || 0;
      const d = precoDiag(paginas);
      min += d[0]; max += d[1];
    }
    if (servico === 'completo') {
      min *= 1 - PRECOS.descontoCompleto;
      max *= 1 - PRECOS.descontoCompleto;
    }

    // série: cada volume extra tem desconto progressivo
    const volumes = parseInt($('f-volumes').value, 10);
    let fator = 0;
    for (let v = 0; v < volumes; v++) {
      fator += 1 - Math.min(v * PRECOS.descontoSeriePorVolume, PRECOS.descontoSerieMax);
    }
    min *= fator; max *= fator;

    const urgente = $('f-prazo').value === 'urgente';
    if (urgente) { min *= 1 + PRECOS.urgencia; max *= 1 + PRECOS.urgencia; }

    min = r10(min); max = r10(max);

    const texto = `${brl(min)} – ${brl(max)}`;
    $('estimate-value').textContent = texto;
    const partes = [];
    if (volumes > 1) partes.push(`${volumes} volumes, com desconto progressivo de série`);
    if (servico === 'completo') partes.push(`${PRECOS.descontoCompleto * 100}% de desconto do pacote completo`);
    if (urgente) partes.push(`inclui +${PRECOS.urgencia * 100}% de urgência`);
    $('estimate-detail').textContent = partes.join(' · ');
    $('estimate-pay').textContent = `Sinal de 50%: ${brl(r10(min / 2))} – ${brl(r10(max / 2))}`;
    $('f-estimativa').value = texto + (partes.length ? ` (${partes.join('; ')})` : '');
  }

  form.addEventListener('input', calcular);
  form.addEventListener('change', calcular);
  calcular();

  // ---- Envio: salva a ficha no painel (Supabase) e avisa por e-mail (Formspree) ----
  const txt = (name) => {
    const el = form.elements[name];
    if (!el || el.closest('[hidden]')) return null;
    const v = (el.value || '').trim();
    return v === '' ? null : v;
  };

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const status = $('form-status');
    const botao = $('f-enviar');
    botao.disabled = true;
    status.textContent = 'Enviando...';

    const servico = $('f-servico').value;
    const temCapa = servico !== 'diagramacao';
    const temDiag = servico !== 'capa';

    const ficha = {
      nome: txt('nome'),
      email: txt('email'),
      titulo: txt('titulo'),
      nome_capa: txt('nome_capa'),
      genero: txt('genero'),
      servico,
      tipo_capa: temCapa ? $('f-capa').value : null,
      paginas: temDiag ? (parseInt($('f-paginas').value, 10) || null) : null,
      volumes: parseInt($('f-volumes').value, 10),
      urgente: $('f-prazo').value === 'urgente',
      sinopse: txt('sinopse'),
      direcao_visual: txt('direcao_visual'),
      referencias: txt('referencias'),
      manuscrito: txt('manuscrito'),
      data_desejada: txt('data_desejada'),
      aceite_termos: form.elements['aceite_termos'].checked
    };

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/atelier_fichas`, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_KEY,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(ficha)
      });
      if (!res.ok) throw new Error(await res.text());
    } catch (err) {
      console.error('Erro ao salvar ficha:', err);
      status.textContent = 'Não foi possível enviar agora. Tente de novo em alguns minutos.';
      botao.disabled = false;
      return;
    }

    // aviso por e-mail (opcional; não bloqueia se falhar)
    if (!FORMSPREE_URL.includes('YOUR_FORM_ID')) {
      try {
        await fetch(FORMSPREE_URL, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form)
        });
      } catch (err) { console.warn('Aviso por e-mail falhou:', err); }
    }

    form.hidden = true;
    $('form-success').hidden = false;
    $('form-success').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

<style>
  .atelier-hero {
    padding: var(--space-16) 0 var(--space-12);
    text-align: center;
  }
  
  .atelier-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--kcin-gold-light);
    margin: var(--space-3) 0 var(--space-6);
    letter-spacing: 0.05em;
  }
  
  .atelier-tagline {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--kcin-parchment);
    line-height: 1.7;
  }
  
  /* Nota de atelier seletivo */
  .atelier-note-section {
    padding: var(--space-8) 0;
  }
  
  .atelier-note {
    padding: var(--space-8);
    background: linear-gradient(135deg, 
      rgba(74, 46, 95, 0.15), 
      rgba(15, 58, 46, 0.08));
    border: 1px solid var(--kcin-gold-dim);
    border-radius: var(--radius-md);
    position: relative;
  }
  
  .atelier-note::before {
    content: '❝';
    position: absolute;
    top: -8px;
    left: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--kcin-gold);
    background: var(--kcin-night);
    padding: 0 var(--space-2);
    line-height: 1;
  }
  
  .atelier-note-text {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--kcin-parchment);
    line-height: 1.8;
    font-style: italic;
    margin: 0;
    text-align: center;
  }
  
  .atelier-note-text em {
    color: var(--kcin-gold);
  }
  
  .atelier-philosophy {
    padding: var(--space-16) 0;
  }
  
  .philosophy-text {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--kcin-parchment);
    line-height: 1.9;
    margin-bottom: var(--space-4);
  }
  
  .philosophy-text em {
    color: var(--kcin-gold);
    font-style: italic;
  }
  
  .genres-section {
    padding: var(--space-16) 0;
