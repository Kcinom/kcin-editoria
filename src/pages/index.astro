---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookRow from '../components/BookRow.astro';
import BookSheet from '../components/BookSheet.astro';
import Icon from '../components/Icon.astro';
import { livros, generos, fileiras } from '../data/livros';

// Destaque da vitrine (troque o slug para mudar o livro em destaque)
const destaque = livros.find(l => l.slug === 'sussurro-do-dragao-i')!;
const volumesSerie = livros.filter(l => l.series && l.series === destaque.series).length;
const rows = fileiras();
const doWattpad = livros.filter(l => l.wattpadLink);
---

<BaseLayout title="Editora indie multigênero">
  <div class="app-page">
    <section class="container feature" aria-label="Destaque">
      <div class="feature-bg" aria-hidden="true"><img src={destaque.cover} alt="" /></div>
      <button type="button" class="feature-cover" data-slug={destaque.slug} aria-label={`Detalhes de ${destaque.title}`}>
        <img src={destaque.cover} alt={`Capa de ${destaque.title}`} />
      </button>
      <div class="feature-info">
        <p class="feature-kicker">{destaque.series ? `Série · ${volumesSerie} volumes` : 'Destaque'}</p>
        <h1 class="feature-title">{destaque.title}</h1>
        <div class="sheet-chips"><span class="chip">{generos[destaque.genre]}</span></div>
        <div class="feature-actions">
          {destaque.wattpadLink && (
            <a href={destaque.wattpadLink} target="_blank" rel="noopener" class="icon-btn icon-btn-main" aria-label="Ler no Wattpad" title="Ler no Wattpad"><Icon name="play" size={22} /></a>
          )}
          <button type="button" class="icon-btn" data-slug={destaque.slug} aria-label="Detalhes" title="Detalhes"><Icon name="info" size={22} /></button>
          <a href="/acervo" class="icon-btn" aria-label="Acervo completo" title="Acervo completo"><Icon name="layers" size={22} /></a>
        </div>
      </div>
    </section>

    <div class="container rows">
      {rows.slice(0, 3).map(r => <BookRow title={r.title} books={r.books} />)}
      {doWattpad.length > 0 && <BookRow title="Leia no Wattpad" books={doWattpad} />}
    </div>

    <section class="container">
      <a href="/servicos" class="atelier-tile" aria-label="Atelier: capa e diagramação">
        <div class="atelier-tile-fan" aria-hidden="true">
          <img src="/capas/margaretty.jpg" alt="" />
          <img src="/capas/amelia.jpg" alt="" />
          <img src="/capas/explicando-amor.jpg" alt="" />
        </div>
        <div class="atelier-tile-text">
          <h2>Atelier</h2>
          <p>Capa e diagramação para autores indie</p>
        </div>
        <span class="icon-btn icon-btn-main" aria-hidden="true"><Icon name="brush" size={22} /></span>
      </a>
    </section>
  </div>

  <BookSheet />
</BaseLayout>
