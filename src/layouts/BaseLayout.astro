---
// Layout base — usado em todas as páginas
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** 'dark' (padrão) ou 'light' (Atelier) */
  theme?: 'dark' | 'light';
  /** páginas privadas (painel): não aparecem no Google */
  noindex?: boolean;
}

const { 
  title, 
  description = 'KCIN Editoria — selo independente multigênero. Dark romantasy, fantasia, ficção científica e mais.',
  ogImage = '/og-default.jpg',
  theme = 'dark',
  noindex = false
} = Astro.props;

import '../styles/global.css';
import Icon from '../components/Icon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: '/', label: 'Início', icon: 'home' },
  { href: '/acervo', label: 'Acervo', icon: 'book' },
  { href: '/servicos', label: 'Atelier', icon: 'brush' },
  { href: '/sobre', label: 'Sobre', icon: 'info' },
  { href: '/contato', label: 'Contato', icon: 'mail' },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1A0F2E" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="KCIN" />
  
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title} | KCIN Editoria</title>
  <meta name="description" content={description} />
  
  <meta property="og:title" content={`${title} | KCIN Editoria`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  
  <meta name="twitter:card" content="summary_large_image" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  
  <!-- Fontes KCIN — carregadas aqui no head pra renderização confiável -->
  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Italianno&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" 
  />
</head>

<body class={`theme-${theme}`}>
  <div class="glass-backdrop" aria-hidden="true">
    <img src="/capas/sussurro-i.jpg" alt="" class="gb gb-1" />
    <img src="/capas/miraa.jpg" alt="" class="gb gb-2" />
    <img src="/capas/amelia.jpg" alt="" class="gb gb-3" />
    <img src="/capas/kagami-1.jpg" alt="" class="gb gb-4" />
    <img src="/capas/love-greater.jpg" alt="" class="gb gb-5" />
  </div>
  <aside class="rail" id="rail" aria-label="Menu" style={`--i:${Math.max(0, navItems.findIndex(n => n.href === path))}`} data-has-active={navItems.some(n => n.href === path) ? 'true' : 'false'}>
    <span class="rail-dot" aria-hidden="true"></span>
    <a href="/" class="rail-logo" aria-label="KCIN Editoria - Início" title="KCIN Editoria"><img src="/icon-192.png" alt="" /></a>
    <button type="button" class="rail-toggle" id="rail-toggle" aria-label="Abrir menu" aria-expanded="false" title="Abrir menu"><Icon name="right" size={16} /></button>
    <nav class="rail-nav">
      {navItems.map((i, idx) => (
        <a href={i.href} class="rail-item" data-idx={idx} title={i.label} aria-current={path === i.href ? 'page' : undefined}>
          <span class="rail-ico"><Icon name={i.icon} size={20} /></span><span class="rail-label">{i.label}</span>
        </a>
      ))}
    </nav>
    <a href="#" class="rail-adm adm-atalho" hidden title="Meu painel" aria-label="Meu painel"><Icon name="lock" size={19} /></a>
  </aside>

  <header class="site-header">
    <div class="container header-content">
      <a href="/" class="logo" aria-label="KCIN Editoria - Página inicial">
        <img src="/logo-kcin.svg" alt="KCIN" class="logo-svg" />
        <span class="logo-tagline">Editoria</span>
      </a>
      
      <nav class="nav" aria-label="Navegação principal">
        {navItems.slice(1).map(i => (
          <a href={i.href} class="nav-link nav-pill" title={i.label} aria-label={i.label} aria-current={path === i.href ? 'page' : undefined}>
            <Icon name={i.icon} size={20} /><span class="sr-only">{i.label}</span>
          </a>
        ))}
      </nav>
      
      <a href="#" class="icon-btn adm-head-btn adm-atalho" hidden title="Meu painel" aria-label="Meu painel"><Icon name="lock" size={19} /></a>
      <button type="button" class="icon-btn install-btn" id="instalar" hidden aria-label="Instalar app" title="Instalar app"><Icon name="install" size={20} /></button>

      <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <nav class="tabbar" aria-label="Navegação" style={`--i:${Math.max(0, navItems.findIndex(n => n.href === path))}`} data-has-active={navItems.some(n => n.href === path) ? 'true' : 'false'}>
    <span class="tab-dot" aria-hidden="true"></span>
    {navItems.map((i, idx) => (
      <a href={i.href} class="tab" data-idx={idx} title={i.label} aria-label={i.label} aria-current={path === i.href ? 'page' : undefined}>
        <Icon name={i.icon} size={24} /><span class="sr-only">{i.label}</span>
      </a>
    ))}
  </nav>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo logo-footer">
            <img src="/logo-kcin.svg" alt="KCIN" class="logo-svg" />
            <span class="logo-tagline">Editoria</span>
          </a>
          <p class="footer-tagline">
            Selo independente multigênero.<br />
            Ficção e não-ficção autoral.
          </p>
        </div>
        
        <div class="footer-section">
          <h4 class="footer-heading">Acervo</h4>
          <ul>
            <li><a href="/acervo?g=romantasy" class="link-elegant">Dark Romantasy</a></li>
            <li><a href="/acervo?g=fantasy-eastern" class="link-elegant">Fantasia Oriental</a></li>
            <li><a href="/acervo?g=scifi" class="link-elegant">Ficção Científica</a></li>
            <li><a href="/acervo?g=romance" class="link-elegant">Romance</a></li>
            <li><a href="/acervo?g=nonfiction" class="link-elegant">Não-ficção</a></li>
            <li><a href="/acervo?g=fanfic" class="link-elegant">Fanfics</a></li>
          </ul>
        </div>
        
        <div class="footer-section">
          <h4 class="footer-heading">KCIN</h4>
          <ul>
            <li><a href="/sobre" class="link-elegant">Sobre o selo</a></li>
            <li><a href="/servicos" class="link-elegant">Atelier · Capa e diagramação</a></li>
            <li><a href="/contato" class="link-elegant">Contato</a></li>
          </ul>
        </div>
        
        <div class="footer-section">
          <h4 class="footer-heading">Conecte-se</h4>
          <ul class="social-links">
            <li><a href="#" class="link-elegant" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="#" class="link-elegant" target="_blank" rel="noopener">TikTok</a></li>
            <li><a href="#" class="link-elegant" target="_blank" rel="noopener">Amazon</a></li>
          </ul>
        </div>
      </div>
      
      <div class="divider-ornament">
        <span>❦</span>
      </div>
      
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} KCIN Editoria. Todos os direitos reservados.</p>
        <p class="footer-credit">Idealizada por Kcinom Nilpoj</p>
      </div>
    </div>
  </footer>
  
  <script>
    const toggle = document.querySelector('.nav-toggle');
    const nav = document.querySelector('.nav');
    
    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      nav?.classList.toggle('nav-open');
    });
    
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, observerOptions);
    
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
    
    const header = document.querySelector('.site-header');
    
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;
      if (currentScroll > 100) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    });
  </script>
</body>
</html>

<script>
  const rail = document.getElementById('rail');
  const railBtn = document.getElementById('rail-toggle');
  const setRail = (aberto: boolean) => {
    rail?.classList.toggle('open', aberto);
    document.body.classList.toggle('rail-open', aberto);
    railBtn?.setAttribute('aria-expanded', String(aberto));
    railBtn?.setAttribute('aria-label', aberto ? 'Recolher menu' : 'Abrir menu');
    try { localStorage.setItem('kcin-rail', aberto ? '1' : '0'); } catch {}
  };
  try { if (localStorage.getItem('kcin-rail') === '1') setRail(true); } catch {}
  // atalho do painel: só aparece no aparelho onde a autora já entrou
  try { const adm = localStorage.getItem('kcin-adm'); if (adm && adm.startsWith('/k-')) document.querySelectorAll<HTMLAnchorElement>('.adm-atalho').forEach(a => { a.href = adm; a.hidden = false; }); } catch {}
  railBtn?.addEventListener('click', () => setRail(!rail?.classList.contains('open')));

  // barra de baixo: o círculo desliza até o ícone tocado antes de trocar de página
  const tabbar = document.querySelector<HTMLElement>('.tabbar');
  const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  tabbar?.querySelectorAll<HTMLAnchorElement>('.tab').forEach(t => {
    t.addEventListener('click', (e) => {
      if (t.getAttribute('aria-current') === 'page' || calmo || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      tabbar.dataset.hasActive = 'true';
      tabbar.querySelectorAll('.tab').forEach(x => x.removeAttribute('aria-current'));
      t.setAttribute('aria-current', 'page');
      tabbar.classList.remove('moving'); void tabbar.offsetWidth; tabbar.classList.add('moving');
      tabbar.style.setProperty('--i', t.dataset.idx || '0');
      setTimeout(() => { location.href = t.href; }, 320);
    });
  });

  // menu lateral (recolhido): o círculo desliza na vertical antes de trocar de página
  rail?.querySelectorAll<HTMLAnchorElement>('.rail-item').forEach(t => {
    t.addEventListener('click', (e) => {
      if (t.getAttribute('aria-current') === 'page' || calmo || e.metaKey || e.ctrlKey || rail.classList.contains('open')) return;
      e.preventDefault();
      rail.dataset.hasActive = 'true';
      rail.querySelectorAll('.rail-item').forEach(x => x.removeAttribute('aria-current'));
      t.setAttribute('aria-current', 'page');
      rail.classList.remove('moving'); void rail.offsetWidth; rail.classList.add('moving');
      rail.style.setProperty('--i', t.dataset.idx || '0');
      setTimeout(() => { location.href = t.href; }, 320);
    });
  });

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  }
  let pedido: any = null;
  const botao = document.getElementById('instalar');
  window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); pedido = e; if (botao) botao.hidden = false; });
  botao?.addEventListener('click', async () => { if (!pedido) return; pedido.prompt(); await pedido.userChoice; pedido = null; botao.hidden = true; });
  window.addEventListener('appinstalled', () => { if (botao) botao.hidden = true; });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-6) 0;
    background: rgba(10, 6, 18, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: padding var(--duration-base) var(--ease), 
                background var(--duration-base) var(--ease);
    border-bottom: 1px solid transparent;
  }
  
  .site-header.scrolled {
    padding: var(--space-3) 0;
    background: rgba(10, 6, 18, 0.95);
    border-bottom-color: rgba(212, 165, 116, 0.15);
  }
  
  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--kcin-gold-light);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease);
  }
  
  .logo:hover {
    opacity: 0.8;
  }
  
  .logo-svg {
    height: 36px;
    width: auto;
    /* Recolore SVG preta pra dourado champagne KCIN via filter */
    filter: invert(74%) sepia(33%) saturate(456%) hue-rotate(347deg) brightness(96%) contrast(89%);
    transition: height var(--duration-base) var(--ease);
  }
  
  .site-header.scrolled .logo-svg {
    height: 28px;
  }
  
  .logo-tagline {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--kcin-gold-dim);
    letter-spacing: 0.5em;
    text-transform: uppercase;
    padding-top: 6px;
    padding-left: 0.5em;
  }
  
  .logo-footer .logo-svg {
    height: 32px;
  }
  
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  
  .nav-link {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--kcin-parchment);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease);
    position: relative;
  }
  
  .nav-link:hover {
    color: var(--kcin-gold);
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1px;
    background: var(--kcin-gold);
    transition: width var(--duration-base) var(--ease-out);
  }
  
  .nav-link:hover::after {
    width: 100%;
  }
  
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }
  
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--kcin-gold);
    transition: transform var(--duration-base) var(--ease);
  }
  
  @media (max-width: 768px) {
    .nav {
      position: fixed;
      top: 80px;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: var(--space-8) var(--space-6);
      background: rgba(10, 6, 18, 0.98);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(212, 165, 116, 0.15);
      gap: var(--space-6);
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: transform var(--duration-base) var(--ease), 
                  opacity var(--duration-base) var(--ease);
    }
    
    .nav.nav-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    
    .nav-toggle {
      display: flex;
    }
    
    .nav-toggle[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    
    .nav-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }
    
    .nav-toggle[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
  
  .site-footer {
    margin-top: var(--space-32);
    padding: var(--space-16) 0 var(--space-8);
    background: var(--kcin-night);
    border-top: 1px solid rgba(212, 165, 116, 0.2);
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }
  
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  
  .footer-brand {
    max-width: 320px;
  }
  
  .footer-tagline {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--kcin-ash);
    line-height: 1.8;
  }
  
  .footer-heading {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--kcin-gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  
  .footer-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  
  .footer-section li {
    font-size: var(--text-sm);
  }
  
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(212, 165, 116, 0.1);
    font-size: var(--text-xs);
    color: var(--kcin-gold-dim);
    letter-spacing: 0.1em;
  }
  
  .footer-bottom p {
    margin: 0;
  }
  
  .footer-credit {
    font-family: var(--font-script);
    font-size: var(--text-base);
    color: var(--kcin-gold);
    letter-spacing: normal;
  }
  
  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      gap: var(--space-3);
      text-align: center;
    }
  }
  
  main {
    padding-top: 100px;
  }
</style>
