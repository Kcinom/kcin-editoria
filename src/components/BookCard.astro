---
export interface Props {
  title: string;
  subtitle?: string;
  cover: string;
  slug: string;
  genre: 'romantasy' | 'fantasy-eastern' | 'fantasy-lit' | 'scifi' | 'steampunk' | 'romance' | 'nonfiction';
  authors?: string[];
  series?: string;
  volume?: number;
  /** Link Amazon — se fornecido, card abre Amazon. Se ausente, abre página interna */
  amazonLink?: string;
  /** Link Wattpad — se fornecido + isWattpad, card abre Wattpad */
  wattpadLink?: string;
  /** Marca como fanfic do Wattpad (esconde "Comprar" e mostra "Ler no Wattpad") */
  isWattpad?: boolean;
}

const { 
  title, 
  subtitle, 
  cover, 
  slug, 
  genre, 
  authors = [], 
  series, 
  volume,
  amazonLink,
  wattpadLink,
  isWattpad = false,
} = Astro.props;

const genreColors = {
  'romantasy': 'var(--color-romantasy)',
  'fantasy-eastern': 'var(--color-fantasy-eastern)',
  'fantasy-lit': 'var(--color-fantasy-lit)',
  'scifi': 'var(--color-scifi)',
  'steampunk': 'var(--color-steampunk)',
  'romance': 'var(--color-romance)',
  'nonfiction': 'var(--color-nonfiction)'
};

const genreLabel = {
  'romantasy': 'Dark Romantasy',
  'fantasy-eastern': 'Fantasia Oriental',
  'fantasy-lit': 'Fantasia Literária',
  'scifi': 'Ficção Científica',
  'steampunk': 'Steampunk',
  'romance': 'Romance',
  'nonfiction': 'Não-ficção'
};

const cardColor = genreColors[genre];
const cardLabel = genreLabel[genre];

// Define destino do link com prioridade:
// 1. Se Wattpad + tem link → Wattpad
// 2. Se tem amazonLink → Amazon
// 3. Senão → página interna
let href: string;
let isExternal = false;
let actionText = 'Detalhes →';

if (isWattpad && wattpadLink) {
  href = wattpadLink;
  isExternal = true;
  actionText = 'Ler no Wattpad →';
} else if (isWattpad) {
  href = `/livros/${slug}`;
  actionText = 'Sobre a fanfic →';
} else if (amazonLink) {
  href = amazonLink;
  isExternal = true;
  actionText = 'Ver na Amazon →';
} else {
  href = `/livros/${slug}`;
}
---

<a 
  href={href} 
  class="book-card fade-in" 
  style={`--card-color: ${cardColor}`}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <div class="card-cover-wrap">
    <div class="card-fallback" aria-hidden="true">
      <span class="card-fallback-brand">KCIN</span>
      <span class="card-fallback-title">{title}</span>
      {subtitle && <span class="card-fallback-sub">{subtitle}</span>}
      <span class="card-fallback-author">Kcinom Nilpoj</span>
    </div>
    <img src={cover} alt={`Capa de ${title}`} loading="lazy" class="card-cover" onerror="this.style.display='none'" />
    <div class="card-glow"></div>
    
    <div class="card-overlay">
      <div class="card-tags-top">
        <span class="card-genre">{cardLabel}</span>
        {isWattpad && <span class="card-wattpad">Wattpad</span>}
      </div>
      {volume && <span class="card-volume">Vol. {volume}</span>}
    </div>
    
    <div class="card-hover-action">
      <span class="card-action-text">{actionText}</span>
    </div>
  </div>
  
  <div class="card-info">
    {series && <p class="card-series">{series}</p>}
    <h3 class="card-title">{title}</h3>
    {subtitle && <p class="card-subtitle">{subtitle}</p>}
    {authors.length > 0 && (
      <p class="card-authors">
        {authors.join(' • ')}
      </p>
    )}
  </div>
</a>

<style>
  .book-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-base) var(--ease-out);
    position: relative;
  }
  
  .book-card:hover {
    transform: translateY(-6px);
  }
  
  .card-cover-wrap {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--card-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-deep);
    transition: box-shadow var(--duration-base) var(--ease);
  }
  
  .book-card:hover .card-cover-wrap {
    box-shadow: var(--shadow-deep), 0 0 40px var(--card-color);
  }
  
  /* Capa provisória: aparece quando a imagem da capa não existe */
  .card-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    text-align: center;
    background:
      radial-gradient(ellipse at top, rgba(212, 165, 116, 0.18), transparent 60%),
      var(--card-color);
    border: 1px solid rgba(212, 165, 116, 0.35);
    border-radius: var(--radius-md);
  }

  .card-fallback-brand {
    position: absolute;
    top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.4em;
    color: var(--kcin-gold-dim);
  }

  .card-fallback-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.25;
    color: var(--kcin-gold-light);
    letter-spacing: 0.05em;
  }

  .card-fallback-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--kcin-parchment);
  }

  .card-fallback-author {
    position: absolute;
    bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--kcin-gold);
  }

  .card-cover {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  
  .book-card:hover .card-cover {
    transform: scale(1.05);
  }
  
  .card-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, 
      transparent 30%, 
      rgba(212, 165, 116, 0.15) 50%, 
      transparent 70%);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease);
    pointer-events: none;
  }
  
  .book-card:hover .card-glow {
    opacity: 1;
  }
  
  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease);
    pointer-events: none;
  }
  
  .book-card:hover .card-overlay {
    opacity: 1;
  }
  
  .card-tags-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
  }
  
  .card-genre {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--kcin-gold-light);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.8);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--kcin-gold-dim);
    border-radius: var(--radius-sm);
  }
  
  /* Tag específica de Wattpad — verde discreto */
  .card-wattpad {
    font-family: var(--font-display);
    font-size: 0.65rem;
    color: #4a9d6c;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.85);
    padding: 2px var(--space-2);
    border: 1px solid #4a9d6c;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }
  
  .card-volume {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--kcin-gold);
    background: rgba(0, 0, 0, 0.8);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    letter-spacing: 0.1em;
  }
  
  .card-hover-action {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-4) var(--space-3);
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.9), transparent);
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity var(--duration-base) var(--ease),
                transform var(--duration-base) var(--ease-out);
    pointer-events: none;
  }
  
  .book-card:hover .card-hover-action {
    opacity: 1;
    transform: translateY(0);
  }
  
  .card-action-text {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--kcin-gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--kcin-gold);
    border-radius: var(--radius-sm);
    background: rgba(10, 6, 18, 0.6);
    backdrop-filter: blur(4px);
    display: inline-block;
  }
  
  .card-info {
    padding-top: var(--space-3);
    text-align: center;
  }
  
  .card-series {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--kcin-gold-dim);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }
  
  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--kcin-gold-light);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
    line-height: 1.3;
  }
  
  .card-subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--kcin-parchment);
    margin-bottom: var(--space-2);
    opacity: 0.9;
  }
  
  .card-authors {
    font-family: var(--font-serif);
    font-size: var(--text-xs);
    color: var(--kcin-ash);
    letter-spacing: 0.05em;
    margin: 0;
  }
</style>
